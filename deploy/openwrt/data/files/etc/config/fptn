config fptn 'config'
	# The domain list lives in /etc/fptn/split_tunnel_domains.txt
	option split_tunnel_domains_file '/etc/fptn/split_tunnel_domains.txt'
	option enabled '0'
	option access_token ''
	option preferred_server ''
	# Регулярка: серверы с подходящим именем в пул не попадают.
	option exclude_servers ''
	# Предел задержки, мс. 0 - без ограничения.
	option max_ping '0'
	option out_network_interface ''
	option tun_interface_name 'tun0'
	option sni ''
	option bypass_method 'obfuscation'
	option connection_strategy 'dual-rolling-tunnel'
	option mtu_size '1420'
	option dns ''
	option use_fptn_dns '1'
	option enable_split_tunnel '1'
	option split_tunnel_mode 'exclude'
	# Coexistence with a transparent proxy (ZeroBlock, mwan3, ...):
	# leave routing alone, expose SOCKS5 instead and mark our own sockets
	# so firewall rules can exclude them from processing.
	option disable_routing '0'
	# SOCKS5 entry point: CONNECT and UDP ASSOCIATE, so TCP and UDP (QUIC) both work.
	option socks_listen ''
	option socks_route_table '1080'
	option routing_mark ''
	list exclude_tunnel_networks '10.0.0.0/8'
	list exclude_tunnel_networks '172.16.0.0/12'
	list exclude_tunnel_networks '192.168.0.0/16'
	list blacklist_domains 'solovev-live.ru'
	list blacklist_domains 'ria.ru'
	list blacklist_domains 'tass.ru'
	list blacklist_domains '1tv.ru'
	list blacklist_domains 'ntv.ru'
	list blacklist_domains 'rt.com'
	list blacklist_domains 'lenta.ru'
