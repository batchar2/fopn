#!/bin/sh

[ -n "$IPKG_INSTROOT" ] && exit 0

# opkg parks the packaged config at /etc/config/fptn-opkg only when the user
# has edited theirs. Moving it over the live file drops their access token and
# every setting they made, so leave both in place: unset options fall back to
# the client's own defaults, and the new file is there to merge from.

if [ -f /etc/uci-defaults/99-fptn ]; then
	( . /etc/uci-defaults/99-fptn ) && rm -f /etc/uci-defaults/99-fptn
fi

/etc/init.d/fptn enable

rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null
/etc/init.d/rpcd restart >/dev/null 2>&1

exit 0
